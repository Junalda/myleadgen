# Kopieer dit bestand naar .env.local en vul je eigen Google API-keys in.
# Deze keys blijven server-side (Next.js API routes) en komen NOOIT in de frontend.

# Google Places API key (Places API moet aan staan in Google Cloud Console)
GOOGLE_PLACES_KEY=your-google-places-api-key

# Google PageSpeed Insights API key (PageSpeed Insights API moet aan staan)
GOOGLE_PSI_KEY=your-google-pagespeed-insights-api-key

# Anthropic API key voor de Claude-stap (lead-filtering + berichtgeneratie).
# Aanmaken op https://console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key
